# Shared environment values for local orchestration
PROJECT_NAME=room-reservation-platform

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-this-to-a-long-random-string
